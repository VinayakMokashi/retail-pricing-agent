# Copy this file to ".env" and fill in your own key.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional (stages 4-6): Cerebras serves the same model with much higher rate limits (https://cloud.cerebras.ai).
# When this is set, stages 4-6 run on Cerebras instead of Groq (stage 6 needs only one of the two keys).
# CEREBRAS_API_KEY=your_cerebras_api_key_here
